{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vaixlns.org/schemas/evidence-record.schema.json",
  "title": "VAIXLNS Evidence Record",
  "type": "object",
  "required": [
    "claim_id",
    "subject",
    "epistemic_state",
    "source",
    "evidence",
    "verification"
  ],
  "properties": {
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "epistemic_state": {
      "enum": [
        "PROPOSAL",
        "SPECIFIED",
        "IMPLEMENTED",
        "VERIFIED",
        "PARTIAL",
        "MISSING",
        "CONFLICT",
        "RECOVERED"
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "kind",
        "ref"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "ref",
          "digest"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "required": [
        "method",
        "result"
      ],
      "properties": {
        "method": {
          "type": "string"
        },
        "result": {
          "enum": [
            "PASS",
            "FAIL",
            "PARTIAL"
          ]
        },
        "reproduction_command": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "authority": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "lineage": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
