{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vaixlns.org/schemas/provenance-record.schema.json",
  "title": "VAIXLNS Provenance Record",
  "description": "VAIXLNS provenance envelope; conceptually compatible with SLSA/in-toto but not a declaration of compliance.",
  "type": "object",
  "required": [
    "schema_version",
    "subject",
    "source",
    "builder",
    "invocation",
    "materials"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "subject": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "digest"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "repository",
        "revision"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      }
    },
    "builder": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        }
      }
    },
    "invocation": {
      "type": "object",
      "required": [
        "command"
      ],
      "properties": {
        "command": {
          "type": "string"
        }
      }
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "uri",
          "digest"
        ],
        "properties": {
          "uri": {
            "type": "string"
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
