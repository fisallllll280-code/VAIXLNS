{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vaixlns.org/schemas/guarded-repair-plan.v1.schema.json",
  "title": "Guarded Repair Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repair_id",
    "repository",
    "base_revision",
    "change"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "repair_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "base_revision": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40,64}$"
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "operation",
        "expected_sha256",
        "old_text",
        "new_text"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
        },
        "operation": {
          "const": "replace_text"
        },
        "expected_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "old_text": {
          "type": "string",
          "minLength": 1
        },
        "new_text": {
          "type": "string"
        },
        "expected_occurrences": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      }
    }
  }
}
