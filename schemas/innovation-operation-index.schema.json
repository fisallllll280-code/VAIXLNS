{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vaixlns.local/schema/innovation-operation-index-v1.json",
  "title": "VAIXLNS Innovation Operation Index",
  "type": "object",
  "required": [
    "schema",
    "canonical_source",
    "authority_anchor",
    "master_index",
    "generation",
    "summary",
    "items"
  ],
  "properties": {
    "schema": {
      "const": "VAIXLNS.InnovationOperationIndex.v1"
    },
    "canonical_source": {
      "const": "project.genome::v1.0.0"
    },
    "authority_anchor": {
      "const": "Ω0_GENESIS_CORE"
    },
    "master_index": {
      "const": "Ω.000"
    },
    "generation": {
      "type": "object",
      "required": [
        "mode",
        "generator",
        "profile_source",
        "source_files",
        "generated_timestamp",
        "state_promotion"
      ],
      "properties": {
        "mode": {
          "const": "deterministic"
        },
        "generator": {
          "type": "string"
        },
        "profile_source": {
          "type": "string"
        },
        "source_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "generated_timestamp": {
          "type": [
            "string",
            "null"
          ]
        },
        "state_promotion": {
          "const": "DISABLED"
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": [
        "record_count",
        "status_counts",
        "profile_quality_counts",
        "manual_review_required"
      ],
      "properties": {
        "record_count": {
          "type": "integer",
          "minimum": 0
        },
        "status_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "profile_quality_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "manual_review_required": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/innovation"
      }
    }
  },
  "$defs": {
    "observation": {
      "type": "object",
      "required": [
        "source",
        "state",
        "axis"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "axis": {
          "enum": [
            "readiness",
            "measurement"
          ]
        }
      },
      "additionalProperties": false
    },
    "innovation": {
      "type": "object",
      "required": [
        "canonical_id",
        "name",
        "family",
        "owner",
        "status",
        "source_statuses",
        "status_observations",
        "status_disagreement",
        "description",
        "description_basis",
        "operating_mechanism",
        "mechanism_basis",
        "profile_quality",
        "inputs",
        "outputs",
        "admission_gates",
        "failure_modes",
        "dependencies",
        "relationships",
        "native_ids",
        "source_refs",
        "evidence_refs",
        "review_required",
        "canonical_promotion_allowed"
      ],
      "properties": {
        "canonical_id": {
          "type": "string",
          "pattern": "^INNOV-[A-F0-9]{12}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "family": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "CANONICAL",
            "VERIFIED",
            "IMPLEMENTED",
            "SPECIFIED",
            "PARTIAL",
            "MISSING",
            "CONFLICT",
            "PROPOSAL",
            "RECOVERED",
            "QUARANTINED",
            "SOURCE-ASSERTED",
            "UNKNOWN"
          ]
        },
        "source_statuses": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "status_observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/observation"
          }
        },
        "status_disagreement": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "description_basis": {
          "type": "string",
          "minLength": 1
        },
        "operating_mechanism": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mechanism_basis": {
          "type": "string",
          "minLength": 1
        },
        "profile_quality": {
          "enum": [
            "SOURCE_BACKED",
            "CURATED_DESIGN_DRAFT",
            "RULE_DERIVED_DRAFT"
          ]
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "admission_gates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "failure_modes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "relationships": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "native_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "review_required": {
          "type": "boolean"
        },
        "canonical_promotion_allowed": {
          "const": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
