{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vaixlns.org/schemas/omega-change-capsule.schema.json",
  "title": "VAIXLNS Ω Change Capsule",
  "description": "A version-bound, evidence-carrying candidate-change record. Schema validation alone is not proof of successful execution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capsule_version",
    "capsule_id",
    "task",
    "repository",
    "change",
    "verification",
    "admission"
  ],
  "properties": {
    "capsule_version": {
      "const": "1.0.0"
    },
    "capsule_id": {
      "type": "string",
      "minLength": 1
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "summary",
        "acceptance_criteria"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "base_revision"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 3
        },
        "base_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_paths",
        "changed_paths",
        "diff_sha256"
      ],
      "properties": {
        "allowed_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "changed_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "diff_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "checks",
        "evidence_refs"
      ],
      "properties": {
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "result"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "result": {
                "enum": [
                  "PASS",
                  "FAIL",
                  "SKIP",
                  "INCONCLUSIVE"
                ]
              },
              "command": {
                "type": "string"
              }
            }
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "reason"
      ],
      "properties": {
        "state": {
          "enum": [
            "PROPOSED",
            "BLOCKED",
            "INCONCLUSIVE",
            "ADMITTED"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
