{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vaixlns.org/schemas/atomic-system-record.schema.json",
  "title": "VAIXLNS Atomic System Record",
  "type": "object",
  "required": ["canonical_id", "name", "type", "status", "origin", "lineage"],
  "properties": {
    "legacy_id": {"type": ["string", "null"]},
    "canonical_id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "aliases": {"type": "array", "items": {"type": "string"}},
    "type": {"type": "string"},
    "family": {"type": "string"},
    "domain": {"type": "string"},
    "generation": {"type": ["string", "null"]},
    "status": {"enum": ["RECOVERED","CANONICAL","MERGED","PROPOSED","VARIANT","IMPLEMENTED","VERIFIED","SUPERSEDED"]},
    "origin": {"enum": ["HISTORICAL","CANONICAL_REORG","PROPOSED_INNOVATION","EXTERNAL_REFERENCE"]},
    "meaning": {"type": "string"},
    "parent": {"type": ["string", "null"]},
    "children": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "capabilities": {"type": "array", "items": {"type": "string"}},
    "contracts": {"type": "array", "items": {"type": "string"}},
    "authority": {"type": "array", "items": {"type": "string"}},
    "inputs": {"type": "array", "items": {"type": "string"}},
    "outputs": {"type": "array", "items": {"type": "string"}},
    "state_model": {"type": ["object", "null"]},
    "events": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "proof": {"type": "array", "items": {"type": "string"}},
    "tests": {"type": "array", "items": {"type": "string"}},
    "failure_modes": {"type": "array", "items": {"type": "string"}},
    "recovery": {"type": "array", "items": {"type": "string"}},
    "implementation": {"type": "array", "items": {"type": "string"}},
    "repository": {"type": ["string", "null"]},
    "files": {"type": "array", "items": {"type": "string"}},
    "version": {"type": ["string", "null"]},
    "lineage": {"type": "array", "items": {"type": "string"}},
    "superseded_by": {"type": ["string", "null"]},
    "lifecycle": {"type": ["string", "null"]},
    "evolution_eligibility": {"type": "boolean"}
  },
  "additionalProperties": true
}