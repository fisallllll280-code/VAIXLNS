{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vaixlns.org/schemas/zero-loss-atomic-record.schema.json",
  "title": "VAIXLNS Zero-Loss Atomic Record",
  "description": "Source-bound record for loss-preserving indexing. Automatic indexing cannot confer canonical, implementation, or verification authority.",
  "type": "object",
  "required": [
    "uid",
    "source_id",
    "source_location",
    "source_sha256",
    "fragment_sha256",
    "fragment_hash_kind",
    "legacy_id",
    "canonical_id",
    "name",
    "aliases",
    "type",
    "family",
    "domain",
    "origin",
    "meaning",
    "status",
    "classification_status",
    "semantic_status",
    "ingestion_state",
    "parent",
    "children",
    "lineage",
    "supersedes",
    "superseded_by",
    "dependencies",
    "capabilities",
    "contracts",
    "authority",
    "relations",
    "state",
    "events",
    "execution",
    "evidence",
    "proof",
    "implementation",
    "tests",
    "failure",
    "recovery",
    "version",
    "lifecycle",
    "evolution",
    "source_claimed_status",
    "source_fields",
    "source_excerpt"
  ],
  "properties": {
    "uid": {
      "type": "string",
      "pattern": "^ATOM-[a-f0-9]{24}$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^SRC-[a-f0-9]{24}$"
    },
    "source_location": {
      "type": "object",
      "required": [
        "path",
        "line_start",
        "line_end",
        "json_pointer"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "line_start": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "line_end": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "json_pointer": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "fragment_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "fragment_hash_kind": {
      "type": [
        "string",
        "null"
      ]
    },
    "legacy_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "canonical_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "family": {
      "type": [
        "string",
        "null"
      ]
    },
    "domain": {
      "type": [
        "string",
        "null"
      ]
    },
    "origin": {
      "type": "string"
    },
    "meaning": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "RECOVERED",
        "CANONICAL",
        "PROPOSED",
        "IMPLEMENTED",
        "VERIFIED",
        "PARTIAL",
        "MISSING",
        "CONFLICT",
        "UNRESOLVED",
        "SUPERSEDED",
        "VARIANT",
        "MERGED"
      ]
    },
    "classification_status": {
      "enum": [
        "CLASSIFIED",
        "UNRESOLVED"
      ]
    },
    "semantic_status": {
      "enum": [
        "UNRESOLVED",
        "SOURCE_CLAIM_ONLY",
        "EVIDENCE_REVIEW_PENDING"
      ]
    },
    "ingestion_state": {
      "enum": [
        "SOURCE",
        "ATOMIC",
        "UNRESOLVED"
      ]
    },
    "parent": {
      "type": [
        "string",
        "null"
      ]
    },
    "children": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lineage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "superseded_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authority": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "state": {
      "type": [
        "object",
        "null"
      ]
    },
    "events": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "execution": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "proof": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "implementation": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "failure": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recovery": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "version": {
      "type": [
        "string",
        "null"
      ]
    },
    "lifecycle": {
      "type": [
        "string",
        "null"
      ]
    },
    "evolution": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_claimed_status": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_excerpt": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
