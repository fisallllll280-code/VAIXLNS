{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fisallllll280-code/VAIXLNS/blob/main/schemas/omega-research-result.schema.json",
  "title": "VAIXLNS Ω Research Fabric Result",
  "description": "Evidence-discovery result envelope. Remote discoveries are not proof claims.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "index",
    "query",
    "local_results",
    "previously_indexed_remote_results",
    "remote_discoveries",
    "provider_status",
    "server_status",
    "semantics",
    "result_sha256"
  ],
  "properties": {
    "schema": {
      "const": "vaixlns.omega-research-fabric.v1"
    },
    "index": {
      "type": "object",
      "required": [
        "root",
        "file_count",
        "changed",
        "unchanged",
        "removed",
        "skipped",
        "inventory_sha256"
      ],
      "properties": {
        "root": {
          "type": "string"
        },
        "file_count": {
          "type": "integer",
          "minimum": 0
        },
        "changed": {
          "type": "integer",
          "minimum": 0
        },
        "unchanged": {
          "type": "integer",
          "minimum": 0
        },
        "removed": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "inventory_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "query": {
      "type": "string"
    },
    "local_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "category",
          "sha256",
          "snippet",
          "score",
          "system_refs",
          "omega_refs",
          "engineering_signals",
          "state"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "snippet": {
            "type": "string"
          },
          "score": {
            "type": "number"
          },
          "system_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "omega_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "engineering_signals": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "state": {
            "const": "LOCAL_SOURCE_FOUND_NOT_SEMANTICALLY_VERIFIED"
          }
        },
        "additionalProperties": false
      }
    },
    "previously_indexed_remote_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "provider",
          "source_id",
          "title",
          "url",
          "abstract",
          "published",
          "retrieved_at",
          "content_sha256",
          "state",
          "metadata",
          "score"
        ],
        "properties": {
          "provider": {
            "type": "string"
          },
          "source_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "abstract": {
            "type": "string"
          },
          "published": {
            "type": "string"
          },
          "retrieved_at": {
            "type": "string"
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "state": {
            "const": "DISCOVERED_UNVERIFIED"
          },
          "metadata": {
            "type": "object"
          },
          "score": {
            "type": "number"
          }
        },
        "additionalProperties": true
      }
    },
    "remote_discoveries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "provider",
          "source_id",
          "title",
          "url",
          "abstract",
          "published",
          "metadata",
          "content_sha256",
          "state"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "provider": {
            "type": "string"
          },
          "source_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "abstract": {
            "type": "string"
          },
          "published": {
            "type": "string"
          },
          "metadata": {
            "type": "object"
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "state": {
            "const": "DISCOVERED_UNVERIFIED"
          }
        },
        "additionalProperties": true
      }
    },
    "provider_status": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "provider",
          "state"
        ],
        "properties": {
          "provider": {
            "type": "string"
          },
          "state": {
            "enum": [
              "SEARCH_SUCCEEDED",
              "SEARCH_FAILED"
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "error_type": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "server_status": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "server_id",
          "state"
        ],
        "properties": {
          "server_id": {
            "type": "string"
          },
          "state": {
            "enum": [
              "HEALTHY",
              "ADAPTER_FAILED"
            ]
          },
          "health": {
            "type": "object"
          },
          "results": {
            "type": "array"
          },
          "error_type": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "semantics": {
      "type": "object",
      "required": [
        "local_sha256",
        "remote_hash",
        "remote_state",
        "agents_dispatched",
        "project_code_executed",
        "coverage"
      ],
      "properties": {
        "local_sha256": {
          "type": "string"
        },
        "remote_hash": {
          "type": "string"
        },
        "remote_state": {
          "const": "DISCOVERED_UNVERIFIED"
        },
        "agents_dispatched": {
          "type": "integer",
          "const": 0
        },
        "project_code_executed": {
          "type": "boolean",
          "const": false
        },
        "coverage": {
          "type": "string"
        }
      }
    },
    "result_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
