{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vaixlns.local/schemas/agent-identity-stage-binding-v1.json",
  "title": "VAIXLNS Agent Identity Workflow Stage Binding",
  "type": "object",
  "required": [
    "schema_version",
    "binding_id",
    "binding_version",
    "status",
    "agent_entity_id",
    "workflow_stage_id",
    "agent_registry_revision",
    "workflow_stage_revision",
    "capability_refs",
    "required_capabilities",
    "accepted_input_contracts",
    "emitted_output_contracts",
    "tool_allowlist",
    "declared_effects",
    "authority_profile_ref",
    "runtime_principal_ref",
    "execution_grant_ref",
    "policy_ref",
    "provenance",
    "effective_window",
    "review"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "binding_id": {
      "type": "string",
      "minLength": 1
    },
    "binding_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": [
        "PROPOSED",
        "UNDER_REVIEW",
        "ACTIVE",
        "SUSPENDED",
        "EXPIRED",
        "REVOKED",
        "SUPERSEDED",
        "QUARANTINED",
        "REJECTED"
      ]
    },
    "agent_entity_id": {
      "type": "string",
      "minLength": 1
    },
    "workflow_stage_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_registry_revision": {
      "type": "string",
      "minLength": 1
    },
    "workflow_stage_revision": {
      "type": "string",
      "minLength": 1
    },
    "capability_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "accepted_input_contracts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contractRef"
      },
      "minItems": 1
    },
    "emitted_output_contracts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contractRef"
      },
      "minItems": 1
    },
    "tool_allowlist": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "declared_effects": {
      "type": "array",
      "items": {
        "enum": [
          "READ",
          "ANALYZE",
          "PROPOSE",
          "SANDBOX_EXECUTE",
          "REPOSITORY_WRITE",
          "EXTERNAL_SIDE_EFFECT",
          "PRODUCTION_DEPLOY",
          "CANONICAL_PROMOTION"
        ]
      },
      "uniqueItems": true
    },
    "authority_profile_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "runtime_principal_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "execution_grant_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "policy_ref": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_refs",
        "recorded_at_utc",
        "recorded_by"
      ],
      "properties": {
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 2
        },
        "recorded_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "recorded_by": {
          "type": "string",
          "minLength": 1
        },
        "evidence_digests": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "additionalProperties": false
    },
    "effective_window": {
      "type": "object",
      "required": [
        "not_before_utc",
        "expires_at_utc"
      ],
      "properties": {
        "not_before_utc": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at_utc": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": [
        "review_state",
        "reviewer_ref",
        "decision_ref"
      ],
      "properties": {
        "review_state": {
          "enum": [
            "NOT_REVIEWED",
            "IN_REVIEW",
            "APPROVED",
            "REJECTED",
            "HOLD"
          ]
        },
        "reviewer_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "decision_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "contractRef": {
      "type": "object",
      "required": [
        "contract_id",
        "version"
      ],
      "properties": {
        "contract_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "schema_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([0-9a-f]{64})?$"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ACTIVE"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "review": {
            "properties": {
              "review_state": {
                "const": "APPROVED"
              },
              "decision_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "runtime_principal_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "declared_effects": {
            "contains": {
              "enum": [
                "REPOSITORY_WRITE",
                "EXTERNAL_SIDE_EFFECT",
                "PRODUCTION_DEPLOY",
                "CANONICAL_PROMOTION"
              ]
            }
          }
        },
        "required": [
          "declared_effects"
        ]
      },
      "then": {
        "properties": {
          "execution_grant_ref": {
            "type": "string",
            "minLength": 1
          },
          "authority_profile_ref": {
            "type": "string",
            "minLength": 1
          },
          "runtime_principal_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
