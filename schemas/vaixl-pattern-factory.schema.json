{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VAIXLNS Pattern Factory Evidence",
  "type": "object",
  "required": [
    "schema_version",
    "factory_id",
    "input",
    "topology",
    "candidates",
    "quarantined",
    "selected_pattern",
    "language_fabric",
    "replay_hash",
    "deterministic",
    "evidence_hash",
    "replay"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "factory_id": {"const": "VAIXLNS-PATTERN-FACTORY-001"},
    "input": {
      "type": "object",
      "required": ["problem", "objective", "constraints", "capabilities", "routes_per_direction"],
      "properties": {
        "problem": {"type": "string"},
        "objective": {"type": "string"},
        "constraints": {"type": "array", "items": {"type": "string"}},
        "capabilities": {"type": "array", "items": {"type": "string"}},
        "routes_per_direction": {"type": "integer", "minimum": 1, "maximum": 80}
      }
    },
    "topology": {
      "type": "object",
      "required": ["direction_count", "routes_per_direction", "total_logical_routes", "parallelism_model"],
      "properties": {
        "direction_count": {"const": 10},
        "routes_per_direction": {"type": "integer", "minimum": 1, "maximum": 80},
        "total_logical_routes": {"type": "integer", "minimum": 10, "maximum": 800},
        "parallelism_model": {"const": "logical-bounded-scheduling"}
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["route_id", "direction_id", "pattern_id", "genome_hash", "status", "blocking_findings", "attack_count", "mutation_tests", "mutation_failures", "guardian_decision"]
      }
    },
    "quarantined": {"type": "array"},
    "selected_pattern": {
      "type": ["object", "null"],
      "properties": {
        "private_language": {
          "type": "object",
          "required": ["binding_type","source","fabric","interface","lifecycle"],
          "properties": {
            "binding_type": {"const": "PATTERN_BOUND_PRIVATE_LANGUAGE"},
            "source": {
              "type": "object",
              "required": ["location","repository_persistence","runtime_source_exposure","agent_source_exposure"],
              "properties": {
                "location": {"const": "EXTERNAL_SECRET_VAULT"},
                "repository_persistence": {"const": false},
                "runtime_source_exposure": {"const": false},
                "agent_source_exposure": {"const": false}
              }
            },
            "interface": {
              "type": "object",
              "properties": {
                "mode": {"const": "CAPABILITY_ONLY"},
                "allows_source_export": {"const": false},
                "allows_source_reconstruction": {"const": false},
                "allows_self_authorization": {"const": false}
              }
            }
          }
        }
      }
    },
    "language_fabric": { "type": "object", "required": ["model","layer_count","directions_per_layer","total_directions","layers","cross_layer_gate"], "properties": { "model": {"const":"5-LAYER-4-DIRECTION-FABRIC"}, "layer_count":{"const":5}, "directions_per_layer":{"const":4}, "total_directions":{"const":20}, "layers":{"type":"array","minItems":5,"maxItems":5}, "cross_layer_gate":{"const":"CROSS_LAYER_CONSISTENCY"} } },
    "replay_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "deterministic": {"const": true},
    "evidence_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "replay": {
      "type": "object",
      "required": ["match", "reference_evidence_hash", "replay_evidence_hash", "reference_replay_hash", "replay_replay_hash"],
      "properties": {
        "match": {"type": "boolean"},
        "reference_evidence_hash": {"type": "string"},
        "replay_evidence_hash": {"type": "string"},
        "reference_replay_hash": {"type": "string"},
        "replay_replay_hash": {"type": "string"}
      }
    }
  }
}
