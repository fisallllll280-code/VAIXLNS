{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vaixlns.org/schemas/agent-task-envelope.schema.json",
  "title": "VAIXLNS Agent Task Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "run_id",
    "candidate_id",
    "candidate_fingerprint",
    "source_revision",
    "role",
    "principal_id",
    "capability_contract",
    "input_artifact_refs",
    "required_output_contract",
    "proof_obligations",
    "budget",
    "permitted_tools",
    "authority_grant_ref",
    "issued_at",
    "expires_at",
    "idempotency_key",
    "failure_policy"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "source_revision": {
      "type": "string",
      "minLength": 7
    },
    "role": {
      "enum": [
        "ARCHITECT",
        "MATHEMATICAL_FORMALIST",
        "COMPUTATIONAL_SCIENTIST",
        "PHYSICS_SPECIALIST",
        "IMPLEMENTER",
        "INTEGRATION_ENGINEER",
        "ADVERSARIAL_REVIEWER",
        "INDEPENDENT_VERIFIER",
        "EVOLUTION_JUDGE",
        "MEMORY_CURATOR"
      ]
    },
    "principal_id": {
      "type": "string",
      "minLength": 1
    },
    "capability_contract": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "input_artifact_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_output_contract": {
      "type": "string",
      "minLength": 1
    },
    "proof_obligations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_wall_time_ms",
        "max_tokens",
        "max_tool_calls"
      ],
      "properties": {
        "max_wall_time_ms": {
          "type": "integer",
          "minimum": 1
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "permitted_tools": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "authority_grant_ref": {
      "type": "string",
      "minLength": 1
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 16
    },
    "failure_policy": {
      "const": "FAIL_CLOSED"
    }
  }
}
