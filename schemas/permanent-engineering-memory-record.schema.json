{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vaixlns.org/schemas/permanent-engineering-memory-record.schema.json",
  "title": "VAIXLNS Permanent Engineering Memory Record",
  "description": "Versioned, provenance-bound engineering knowledge record for the append-only memory ledger.",
  "type": "object",
  "required": ["schema_version", "record_id", "memory_type", "subject", "summary", "epistemic_state", "lifecycle_state", "provenance", "evidence", "verification", "lineage", "recorded_at", "previous_record_hash", "record_hash"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_id": {"type": "string", "minLength": 1},
    "memory_type": {"enum": ["DISCOVERY", "DESIGN", "DECISION", "IMPLEMENTATION", "TEST", "FAILURE", "BENCHMARK", "CONSTRAINT", "PATTERN", "LESSON"]},
    "subject": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "epistemic_state": {"enum": ["PROPOSAL", "SPECIFIED", "IMPLEMENTED", "VERIFIED", "PARTIAL", "MISSING", "CONFLICT", "RECOVERED"]},
    "lifecycle_state": {"enum": ["DRAFT", "ACTIVE", "EVOLVING", "QUARANTINED", "ARCHIVED"]},
    "provenance": {
      "type": "object",
      "required": ["repository", "revision", "path", "content_sha256"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "actor": {"type": "string"},
        "observed_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "ref", "digest"],
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "ref": {"type": "string", "minLength": 1},
          "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "note": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "verification": {
      "type": "object",
      "required": ["method", "result"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "result": {"enum": ["NOT_RUN", "PASS", "FAIL", "PARTIAL"]},
        "reproduction_command": {"type": "string"},
        "environment": {"type": "string"},
        "run_ref": {"type": "string"}
      },
      "additionalProperties": true
    },
    "lineage": {
      "type": "object",
      "properties": {
        "derived_from": {"type": "array", "items": {"type": "string"}},
        "supersedes": {"type": "array", "items": {"type": "string"}},
        "related": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "recorded_at": {"type": "string", "format": "date-time"},
    "promotion_authority": {"type": "string"},
    "previous_record_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "record_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "allOf": [{
    "if": {"properties": {"epistemic_state": {"const": "VERIFIED"}}, "required": ["epistemic_state"]},
    "then": {
      "properties": {
        "verification": {
          "properties": {"result": {"const": "PASS"}, "reproduction_command": {"type": "string", "minLength": 1}},
          "required": ["result", "reproduction_command"]
        },
        "evidence": {"minItems": 1}
      }
    }
  }],
  "additionalProperties": false
}
