{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VAIXLNS Windows Support Profile Registry",
  "type": "object",
  "required": ["schema_version", "state", "mode", "profiles", "widgets", "partner_connectors", "governance"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "state": {"enum": ["PROPOSAL", "SPECIFIED", "IMPLEMENTED_PENDING_CI", "VERIFIED"]},
    "mode": {"const": "definitions_only"},
    "profiles": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["profile_id", "kind", "scope", "mutations_allowed"], "properties": {"profile_id": {"type": "string", "minLength": 1}, "kind": {"type": "string", "minLength": 1}, "scope": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "mutations_allowed": {"const": false}}, "additionalProperties": true}},
    "widgets": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["widget_id", "purpose", "data_access", "actions"], "properties": {"widget_id": {"type": "string", "minLength": 1}, "purpose": {"type": "string", "minLength": 1}, "data_access": {"type": "string"}, "actions": {"type": "array", "items": {"type": "string"}}}}},
    "partner_connectors": {"type": "array", "items": {"type": "object", "required": ["partner_id", "state", "external_execution", "approval_required"], "properties": {"partner_id": {"type": "string"}, "state": {"type": "string"}, "external_execution": {"const": false}, "approval_required": {"const": true}}}},
    "governance": {"type": "object", "required": ["automatic_repairs", "canonical_writes", "boot_security_bypass", "destructive_operations", "external_calls"], "properties": {"automatic_repairs": {"const": false}, "canonical_writes": {"const": false}, "boot_security_bypass": {"const": false}, "destructive_operations": {"const": false}, "external_calls": {"const": false}}}
  },
  "additionalProperties": false
}
