      "approval_required_for_remediation": true
    },
    {
      "profile_id": "WIN-RECOVERY-BASE-001",
      "kind": "recovery_triage",
      "scope": ["startup_failure", "system_integrity", "update_failure", "storage_warning"],
      "mutations_allowed": false,
      "approval_required_for_remediation": true
    },
    {
      "profile_id": "WIN-DEVICE-DRIVER-001",
