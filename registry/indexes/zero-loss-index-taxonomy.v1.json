  "source_adapters": [
    {
      "id": "repo_checkout",
      "state": "IMPLEMENTED_BY_BUILD_SCRIPT",
      "scope": "Files visible within the repository checkout; every regular file is SHA-256 cataloged."
    },
    {
      "id": "repository_history",
      "state": "PARTIAL",
      "scope": "Current checkout and its Git revision when available; full remote branch/tag/commit histories require a separate read-only adapter."
    },
    {
      "id": "uploaded_files",
      "state": "NOT_CONNECTED_TO_THIS_BUILD",
      "scope": "Conversation attachments and user file-library items are not visible to a repository-only scanner unless materialized into the checkout."
    },
    {
      "id": "conversations",
      "state": "NOT_CONNECTED_TO_THIS_BUILD",
      "scope": "Conversation sources require an approved export/connector adapter; no conversation content is fabricated."
    },
    {
      "id": "pdf_content",
      "state": "HASHED_CONTENT_EXTRACTION_PENDING",
      "scope": "Repository PDFs are inventoried and hashed; PDF text/page extraction is a separate adapter."
    },
    {
      "id": "diagram_semantics",
      "state": "HASHED_CONTENT_EXTRACTION_PENDING",
      "scope": "Image diagrams are inventoried and hashed; semantic interpretation is not claimed by this scanner."
    },
    {
      "id": "external_repositories",
      "state": "NOT_CONNECTED_TO_THIS_BUILD",
      "scope": "Only repository references found in source are cross-referenced; remote repositories are not cloned or inferred."
    }
  ],
  "invariants": [
    "Every indexed repository file has a stable source_id, exact SHA-256 and repository-relative path.",
    "Every atomic record links to an existing source_id and source location, and carries source lineage.",
    "Original sources are never deleted, overwritten, renamed or merged by the indexing program.",
    "Repeated content is reported as a digest relationship, never silently deleted.",
    "Similarity, name matches and path mentions are candidate relationships only.",
    "Unobserved legacy IDs remain compressed UNRESOLVED candidate gaps and never become fabricated historical records.",
    "Automatic indexing may create SOURCE and ATOMIC records only; it may not promote records to CANONICAL, IMPLEMENTED or VERIFIED.",
    "Opaque files remain indexed by byte digest with content extraction marked pending.",
    "A source claim of IMPLEMENTED or VERIFIED is preserved as source_claimed_status and is not independently certified by indexing."
  ],
  "transition_gates": {
    "SOURCE->ATOMIC": [
      "source_id exists",
      "source_sha256 is valid",
      "source_location is traceable",
      "lineage includes source_id"
    ],
    "ATOMIC->CANONICAL": [
      "explicit canonical_id grounded in source",
      "authority evidence reference",
      "independent canonical admission"
    ],
    "CANONICAL->IMPLEMENTED": [
      "implementation artifact reference",
      "contract/test evidence",
      "authorized state transition"
    ],
    "IMPLEMENTED->VERIFIED": [
      "reproducible test result",
      "proof/evidence reference tied to source revision",
      "verification record"
    ],
    "UNCLASSIFIABLE": "remain UNRESOLVED; do not delete or guess"
  },
  "output_contract": {
    "zero-loss-index.v1.json": "Consolidated 28-view index and integrity manifest.",
    "zero-loss-source-index.v1.json": "Every source file with path, size, revision, media type and SHA-256.",
    "zero-loss-atomic-records.v1.jsonl": "Source and atomic records in deterministic JSON Lines format.",
    "zero-loss-coverage.v1.json": "Coverage, extraction limitations, legacy ID observations and unresolved candidate gaps.",
    "zero-loss-cross-reference.v1.json": "Direct source-path references with locations; no inferred semantic merge."
  }
}
