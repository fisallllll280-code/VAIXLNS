      "evidence_type": "Public repository metadata, README-oriented discovery",
      "authentication": "Optional GITHUB_TOKEN; unauthenticated rate limits apply"
    }
  ],
  "server_adapter": {
    "state": "CONFIGURATION_REQUIRED",
    "default_configured_server_count": 0,
    "manifest_path_example": "config/omega-servers.json",
    "read_only_methods": [
      "GET /health",
      "GET /search?q=..."
    ],
    "required_server_fields": [
      "server_id",
      "base_url",
      "health_path",
      "search_path"
    ],
    "security": "HTTPS for non-loopback hosts; no credentials sent in v1; explicit operator-owned manifest required",
    "supported_response_shape": {
      "results": [
        {
          "id": "source identifier",
          "omega_id": "optional existing Omega ID",
          "title": "display title",
          "url": "source URL",
          "summary": "evidence summary"
        }
      ]
    }
  },
  "evidence_rules": {
    "local_record_hash": "SHA-256 over complete file bytes",
    "remote_record_hash": "SHA-256 over normalized metadata, not the full remote document",
    "discovery_state": "DISCOVERED_UNVERIFIED",
    "verification_gate": "Independent source review, immutable locator, reproducible artifact/hash where applicable, and counterevidence review",
    "canonical_promotion": "Prohibited by search/index tool"
  }
}
